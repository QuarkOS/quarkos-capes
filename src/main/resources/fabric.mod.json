{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Choose, browse and share capes with animation, cloth physics and custom models.",
  "authors": ["Emilio Schwaiger (QuarkOS)"],
  "license": "MIT",
  "icon": "assets/quarkos_capes/icon.png",
  "environment": "client",
  "accessWidener": "quarkos_capes.accesswidener",
  "entrypoints": {
    "client": ["dev.quarkos.capes.QuarkosCapes"],
    "modmenu": ["dev.quarkos.capes.client.ModMenuHook"]
  },
  "mixins": ["quarkos_capes.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "fabric-api": ">=${fabric_api}",
    "cloth-config": ">=${cloth}"
  },
  "suggests": {
    "modmenu": ">=${modmenu}"
  },
  "contact": {
    "homepage": "https://example.org/quarkos-capes",
    "sources": "https://example.org/quarkos-capes/source"
  }
}
